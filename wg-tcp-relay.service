[Unit]
Description=WireGuard TCP-to-UDP relay for Muse peers (Cloud A)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/wg-relay.py stream2udp --stream tcp-listen:127.0.0.1:51822 --udp udp:127.0.0.1:51821
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
